[Unit]
Description=TouchBar hardware service
Documentation=https://github.com/cameroncooper/touchbar
Conflicts=tiny-dfr.service
After=systemd-udevd.service systemd-logind.service
BindsTo=dev-touchbar_display.device
After=dev-touchbar_display.device

[Service]
Type=simple
ExecStart=/usr/lib/touchbar/touchbard --socket /run/touchbar/hardware.sock
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillSignal=SIGTERM
RuntimeDirectory=touchbar
RuntimeDirectoryMode=0755
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateIPC=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=strict
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-input r
DeviceAllow=/dev/uinput rw

[Install]
WantedBy=multi-user.target
