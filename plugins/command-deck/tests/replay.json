    {
      "kind": "touch",
      "contact_id": 1,
      "phase": "up",
      "x": 200,
      "y": 30,
      "time_ms": 40
    },
    {
      "kind": "advance",
      "time_ms": 50
    },
    {
      "kind": "snapshot",
      "name": "completed"
    }
  ]
