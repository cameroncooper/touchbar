{
  "version": 1,
  "item": "launchers",
  "width": 240,
  "broker": {
    "command_runs": [
      {
        "id": "command-probe",
        "request": {
          "command_id": "probe",
          "values": []
        },
        "responses": [
          {
            "kind": "completed",
            "output": [
              {
                "kind": "stdout",
                "body": "touchbar command probe\n"
              }
            ],
            "exit_code": 0,
            "signal": null
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "kind": "touch",
      "contact_id": 1,
